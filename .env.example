# Movie posters (OMDb recommended; TMDB optional)
OMDB_API_KEY=your_omdb_api_key_here
TMDB_API_KEY=

# Conversational agent LLM (OpenAI-compatible)
LLM_API_KEY=your_llm_api_key_here
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile

# Persistent agent memory (SQLite locally, Postgres on Render)
DATABASE_URL=sqlite:///./agent.db

# Semantic search feature flag and chat rate limiting
ENABLE_SEMANTIC=1
CHAT_RATE_LIMIT=20/minute
